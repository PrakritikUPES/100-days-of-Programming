#include <stdio.h>
int main(void) {
    int n, temp, remainder;
    long long reversed = 0;
    printf("Enter an integer: ");
    scanf("%d", &n);
    if (n < 0) {
        printf("%d is NOT a palindrome number.\n", n);
        return 0;
    }
    temp = n;
    while (temp > 0) {
        remainder = temp % 10;
        reversed = (reversed * 10) + remainder;
        temp /= 10;
    }
    if (reversed == n) {
        printf("%d is a palindrome number.\n", n);
    } else {
        printf("%d is NOT a palindrome number.\n", n);
    }

    return 0;
}
