#include <stdio.h>
int main(void) {
    int n, i, count = 0, sum = 0;
    printf("Enter the number of terms (n): ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Please enter a positive integer.\n");
        return 1;
    }
    for (i = 1; count < n; i += 2) {
        sum += i;
        count++;
    }
    printf("The sum of the first %d odd numbers is: %d\n", n, sum);

    return 0;
}
