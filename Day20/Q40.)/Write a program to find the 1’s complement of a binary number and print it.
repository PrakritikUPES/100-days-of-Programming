#include <stdio.h>
int main(void) {
    long long binary, temp;
    long long complement = 0;
    long long place = 1;
    int digit;
    int is_valid = 1;
    printf("Enter a binary number (e.g., 10110): ");
    scanf("%lld", &binary);
    if (binary < 0) {
        printf("Invalid input! Please enter a non-negative binary number.\n");
        return 1;
    }
    if (binary == 0) {
        printf("1's Complement: 1\n");
        return 0;
    }
    temp = binary;
    while (temp > 0) {
        digit = temp % 10;
        if (digit == 0) {
            complement += (1 * place); // 0 becomes 1
        } else if (digit == 1) {
            complement += (0 * place); // 1 becomes 0
        } else {
            is_valid = 0; // Found a digit other than 0 or 1
            break;
        }
        place *= 10;
        temp /= 10;
    }
    if (!is_valid) {
        printf("Error: Input is not a valid binary number (must contain only 0s and 1s).\n");
    } else {
        printf("1's Complement: %lld\n", complement);
    }

    return 0;
}
