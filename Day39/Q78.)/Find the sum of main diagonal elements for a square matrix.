#include <stdio.h>

int main(void) {
    int n, i, j;
    int matrix[50][50];
    long long trace_sum = 0;

    printf("Enter order of the square matrix (n x n): ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid matrix dimension.\n");
        return 1;
    }

    printf("Enter elements of the matrix (%d x %d):\n", n, n);
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (i = 0; i < n; i++) {
        trace_sum += matrix[i][i];
    }

    printf("Sum of main diagonal elements: %lld\n", trace_sum);

    return 0;
}
