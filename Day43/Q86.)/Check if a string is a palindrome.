#include <stdio.h>

int main() {
    char str[100];
    int length = 0;
    int is_palindrome = 1;

    printf("Enter a string: ");
    scanf("%99s", str);

    while (str[length] != '\0') {
        length++;
    }

    int left = 0;
    int right = length - 1;

    while (left < right) {
        if (str[left] != str[right]) {
            is_palindrome = 0;
            break;
        }
        left++;
        right--;
    }

    if (is_palindrome) {
        printf("%s is a palindrome.\n", str);
    } else {
        printf("%s is not a palindrome.\n", str);
    }

    return 0;
}
