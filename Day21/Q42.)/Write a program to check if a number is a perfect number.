#include <stdio.h>

int main(void) {
    int n, i;
    long long sum = 0;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

    if (n <= 1) {
        printf("%d is NOT a perfect number.\n", n);
        return 0;
    }

    for (i = 1; i <= n / 2; i++) {
        if (n % i == 0) {
            sum += i;
        }
    }

    if (sum == n) {
        printf("%d is a perfect number.\n", n);
    } else {
        printf("%d is NOT a perfect number.\n", n);
    }

    return 0;
}
