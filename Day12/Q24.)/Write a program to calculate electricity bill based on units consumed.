#include <stdio.h>
int main(void) {
    float units;
    float bill = 0.0;
    printf("Enter total units consumed: ");
    scanf("%f", &units);
    if (units < 0) {
        printf("Invalid input! Units cannot be negative.\n");
        return 1;
    }
    if (units <= 100) {
        bill = units * 5.0;
    } 
    else if (units <= 200) {
        bill = (100 * 5.0) + ((units - 100) * 7.0);
    } 
    else if (units <= 300) {
        bill = (100 * 5.0) + (100 * 7.0) + ((units - 200) * 10.0);
    } 
    else {
        bill = (100 * 5.0) + (100 * 7.0) + (100 * 10.0) + ((units - 300) * 12.0);
    }
    printf("\n--- Electricity Bill ---\n");
    printf("Units Consumed: %.2f\n", units);
    printf("Total Amount Payable: Rs. %.2f\n", bill);

    return 0;
}
