#include <stdio.h>
#include <math.h>

int main(void) {
    float a, b, c;
    float discriminant, root1, root2, realPart, imagPart;

    printf("Enter coefficients a, b, and c: ");
    scanf("%f %f %f", &a, &b, &c);

    // Check if the equation is quadratic
    if (a == 0) {
        if (b == 0) {
            printf("Invalid equation.\n");
        } else {
            printf("Linear equation: Single root = %.2f\n", -c / b);
        }
        return 0;
    }

    discriminant = (b * b) - (4 * a * c);

    printf("\n--- Results ---\n");

    if (discriminant > 0) {
        // Two distinct real roots
        root1 = (-b + sqrt(discriminant)) / (2 * a);
        root2 = (-b - sqrt(discriminant)) / (2 * a);
        printf("Category: Real and Distinct Roots\n");
        printf("Root 1 = %.2f\n", root1);
        printf("Root 2 = %.2f\n", root2);
    } 
    else if (discriminant == 0) {
        // Two identical real roots
        root1 = -b / (2 * a);
        printf("Category: Real and Equal Roots\n");
        printf("Root 1 = Root 2 = %.2f\n", root1);
    } 
    else {
        // Complex conjugate roots
        realPart = -b / (2 * a);
        imagPart = sqrt(-discriminant) / (2 * a);
        printf("Category: Complex Conjugate Roots\n");
        printf("Root 1 = %.2f + %.2fi\n", realPart, fabsf(imagPart));
        printf("Root 2 = %.2f - %.2fi\n", realPart, fabsf(imagPart));
    }

    return 0;
}
