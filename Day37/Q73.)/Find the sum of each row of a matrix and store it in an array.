#include <stdio.h>

int main(void) {
    int rows, cols, i, j;
    int matrix[50][50];
    int row_sums[50];

    printf("Enter number of rows and columns: ");
    scanf("%d %d", &rows, &cols);

    printf("Enter elements of the matrix (%d x %d):\n", rows, cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (i = 0; i < rows; i++) {
        row_sums[i] = 0;
        for (j = 0; j < cols; j++) {
            row_sums[i] += matrix[i][j];
        }
    }

    printf("\nSum of each row:\n");
    for (i = 0; i < rows; i++) {
        printf("Row %d sum: %d\n", i + 1, row_sums[i]);
    }

    return 0;
}
