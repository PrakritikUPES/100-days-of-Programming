#include <stdio.h>
int main(void) {
    int a, b, i, min, hcf = 1;
    printf("Enter two positive integers: ");
    scanf("%d %d", &a, &b);
    if (a <= 0 || b <= 0) {
        printf("Please enter positive integers greater than 0.\n");
        return 1;
    }
    min = (a < b) ? a : b;
    for (i = 1; i <= min; i++) {
        if (a % i == 0 && b % i == 0) {
            hcf = i; // Update hcf whenever a common divisor is found
        }
    }
    printf("The HCF (GCD) of %d and %d is: %d\n", a, b, hcf);

    return 0;
}
