#include <stdio.h>
int main(void) {
    int n, temp, remainder;
    int sum = 0;
    printf("Enter an integer: ");
    scanf("%d", &n);
    temp = n;
    if (temp < 0) {
        temp = -temp;
    }
    while (temp > 0) {
        remainder = temp % 10;
        sum += remainder;
        temp /= 10;
    }
    printf("Sum of digits of %d is: %d\n", n, sum);

    return 0;
}
