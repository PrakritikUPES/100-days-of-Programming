#include <stdio.h>
int main(void) {
    float cost_price, selling_price;
    float profit, loss, percentage;
    printf("Enter Cost Price (CP): ");
    scanf("%f", &cost_price);

    printf("Enter Selling Price (SP): ");
    scanf("%f", &selling_price);
    if (cost_price <= 0 || selling_price < 0) {
        printf("Invalid input! Prices must be positive values.\n");
        return 1;
    }
    if (selling_price > cost_price) {
        profit = selling_price - cost_price;
        percentage = (profit / cost_price) * 100;
        printf("\nResult: Profit\n");
        printf("Profit Amount: %.2f\n", profit);
        printf("Profit Percentage: %.2f%%\n", percentage);
    } 
    else if (cost_price > selling_price) {
        loss = cost_price - selling_price;
        percentage = (loss / cost_price) * 100;
        printf("\nResult: Loss\n");
        printf("Loss Amount: %.2f\n", loss);
        printf("Loss Percentage: %.2f%%\n", percentage);
    } 
    else {
        printf("\nResult: No Profit, No Loss\n");
    }

    return 0;
}
