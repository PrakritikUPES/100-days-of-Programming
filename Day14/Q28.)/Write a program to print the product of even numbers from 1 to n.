#include <stdio.h>
int main(void) {
    int n, i;
    long long product = 1;
    printf("Enter a positive integer (n): ");
    scanf("%d", &n);
    if (n < 2) {
        printf("There are no even numbers in the range from 1 to %d.\n", n);
        return 0;
    }
    for (i = 2; i <= n; i += 2) {
        product *= i;
    }
    printf("Product of even numbers from 1 to %d: %lld\n", n, product);

    return 0;
}
