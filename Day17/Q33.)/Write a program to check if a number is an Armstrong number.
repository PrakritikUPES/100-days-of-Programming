#include <stdio.h>
int main(void) {
    int n, temp, remainder;
    int digits = 0;
    long long sum = 0;
    printf("Enter an integer: ");
    scanf("%d", &n);
    if (n < 0) {
        printf("%d is NOT an Armstrong number.\n", n);
        return 0;
    }
    if (n == 0) {
        printf("0 is an Armstrong number.\n");
        return 0;
    }
    temp = n;
    while (temp > 0) {
        digits++;
        temp /= 10;
    }
    temp = n;
    while (temp > 0) {
        remainder = temp % 10;
        long long power = 1;
        for (int i = 0; i < digits; i++) {
            power *= remainder;
        }
        sum += power;
        temp /= 10;
    }
    if (sum == n) {
        printf("%d is an Armstrong number.\n", n);
    } else {
        printf("%d is NOT an Armstrong number.\n", n);
    }

    return 0;
}
