#include <stdio.h>

int main(void) {
    int n, i;
    int arr[100];
    long long sum = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    printf("Sum of array elements: %lld\n", sum);

    return 0;
}
