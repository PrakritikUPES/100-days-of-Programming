#include <stdio.h>
int main(void) {
    int n, i, j, is_symmetric = 1;
    int matrix[50][50];

    printf("Enter order of the square matrix (n x n): ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid matrix dimension.\n");
        return 1;
    }

    printf("Enter elements of the matrix (%d x %d):\n", n, n);
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (matrix[i][j] != matrix[j][i]) {
                is_symmetric = 0;
                break;
            }
        }
        if (!is_symmetric) {
            break;
        }
    }

    if (is_symmetric) {
        printf("The matrix is symmetric.\n");
    } else {
        printf("The matrix is not symmetric.\n");
    }

    return 0;
}
